#!/bin/bash
root="${XRK_ROOT:-/xrk}"
# shellcheck source=/dev/null
source "$root/shell_modules/menu_head.sh" 0 1

show_help() {
  echo "用法: xyz-login [参数]"
  echo "选项:"
  echo "  无参数    - 正常重置葵崽账号"
  echo "  数字参数  - 重置葵崽账号并传递该数字参数"
  echo "  --h, -h   - 显示此帮助信息"
  exit 0
}

if [[ "$1" == "--h" || "$1" == "-h" ]]; then
  show_help
fi

_yz="$(xrk_yz_dir)"
[ -d "$_yz" ] || { echo "未找到葵崽目录: $_yz"; exit 1; }

echo "正在重置葵崽账号"
if [ -z "$1" ]; then
  cd "$_yz" && node app login
else
  cd "$_yz" && node app login "$1"
fi
