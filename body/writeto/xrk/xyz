#!/bin/bash
root="${XRK_ROOT:-/xrk}"
# shellcheck source=/dev/null
source "$root/shell_modules/menu_head.sh" 0 1

# 显示帮助信息
show_help() {
  echo "用法: xyz [参数]"
  echo "选项:"
  echo "  无参数    - 正常启动葵崽"
  echo "  数字参数  - 启动葵崽并传递该数字参数"
  echo "  --h, -h   - 显示此帮助信息"
  exit 0
}

# 处理帮助参数
if [[ "$1" == "--h" || "$1" == "-h" ]]; then
  show_help
fi

_yz="$(xrk_yz_dir)"
[ -d "$_yz" ] || { echo "未找到葵崽目录（默认: ${YZ_DEFAULT_DIR:-$HOME/XRK-Yunzai}）"; exit 1; }

echo "正在启动葵崽"
redis-server --daemonize yes --save 900 1 --save 300 10 2>/dev/null || true

if [ -z "$1" ]; then
  cd "$_yz" && node --expose-gc app
else
  cd "$_yz" && node --expose-gc app "$1"
fi
