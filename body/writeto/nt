#!/bin/bash
# NapCat 管理：多 QQ · 多框架 · WebUI
root="${XRK_ROOT:-/xrk}"
# shellcheck source=/dev/null
source "${root}/shell_modules/xrk_base.sh"
xrk_加载底层 install
# shellcheck source=/dev/null
source "${root}/shell_modules/napcat_security.sh"

QQ_DIR="$root/body"
NT_BACK=" XRK · NapCat 管理 "
NT_UI=""

nt_ui_init() {
    [ -n "$NT_UI" ] && return
    NT_UI=dialog
    [ "${NT_FORCE_DIALOG:-}" = 1 ] && return
    # xterminal 连入时会在远端留下 ~/.xterminal，dialog 界面无法正常显示
    [ -d "$HOME/.xterminal" ] && NT_UI=text && return
    [ -n "${XTERMINAL:-}" ] && NT_UI=text && return
    [ -t 0 ] && [ -t 1 ] || NT_UI=text
}

nt_use_text() { nt_ui_init; [ "$NT_UI" = text ]; }

nt_deps() {
    nt_ui_init
    for p in jq xvfb-run; do
        command -v "$p" &>/dev/null || {
            type install_pkg &>/dev/null && install_pkg "$p" || { echo "缺少 $p"; exit 1; }
        }
    done
    if ! nt_use_text; then
        command -v dialog &>/dev/null || {
            type install_pkg &>/dev/null && install_pkg dialog || { echo "缺少 dialog"; exit 1; }
        }
    fi
}

nt_capture() {
    local out st cmd="$1" tty_out=/dev/tty
    shift
    [ -w "$tty_out" ] || tty_out=/dev/stderr
    out=$("$cmd" --backtitle "$NT_BACK" "$@" 2>"$tty_out")
    st=$?
    printf '%s' "$out"
    return $st
}

nt_text_pick() {
    local title="$1" i=1 n tags=() labels=()
    shift
    echo ""
    echo "== $title =="
    while [ $# -ge 2 ]; do
        tags+=("$1"); labels+=("$2")
        echo "  $i) $2"
        shift 2; i=$((i + 1))
    done
    echo "  0) 取消"
    read -rp "请选择: " n
    [[ "$n" =~ ^[0-9]+$ ]] || return 1
    [ "$n" -eq 0 ] && return 1
    [ "$n" -le "${#tags[@]}" ] || return 1
    printf '%s' "${tags[$((n - 1))]}"
}

nt_menu() {
    local title="$1" h="$2" w="$3" mh="$4" sel
    shift 4
    if nt_use_text; then
        nt_text_pick "$title" "$@"
    else
        sel="$(nt_capture dialog --title "$title" --menu "$title" "$h" "$w" "$mh" "$@")"
        printf '%s' "$sel"
    fi
}

nt_input() {
    local prompt="$1" _h="$2" _w="$3" default="${4:-}" v
    if nt_use_text; then
        read -r -p "$prompt${default:+ [$default]}: " v
        printf '%s' "${v:-$default}"
    else
        nt_capture dialog --inputbox "$prompt" "$_h" "$_w" "$default"
    fi
}

nt_yes() { case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in y|yes|1|true|是) return 0 ;; *) return 1 ;; esac; }

nt_msg() {
    if nt_use_text; then
        echo ""; printf '%b\n' "$1"; read -r -p "按回车继续…" _
    else
        nt_capture dialog --title "提示" --msgbox "$1" "${2:-8}" "${3:-52}"
    fi
}

nt_yesno() {
    if nt_use_text; then
        local ans; read -r -p "$1 [y/N]: " ans; nt_yes "$ans"
    else
        nt_capture dialog --yesno "$1" "${2:-7}" "${3:-40}"
    fi
}

# ── 框架 ─────────────────────────────────────────
nt_framework_items() {
    napcat_load_prefs | jq -r '.frameworks[]? | "\(.id)|\(.label)|\(.default_port)"'
}

nt_pick_frameworks() {
    local qq="$1" items=() id label port state old checklist
    old="$(napcat_load_qq_config "${QQ_DIR}/qq_${qq}.json" 2>/dev/null \
        | jq -r '.links[]?|select(.enabled)|.framework_id' 2>/dev/null || true)"
    while IFS='|' read -r id label port; do
        [ -z "$id" ] && continue
        state=off; echo "$old" | grep -qxF "$id" && state=on
        items+=("$id" "$label · :$port" "$state")
    done < <(nt_framework_items)
    [ ${#items[@]} -eq 0 ] && { nt_msg "请先在「框架管理」扫描或添加框架" 7; return 1; }
    if nt_use_text; then
        local i=1 ids=() picked="" sel
        echo ""; echo "== 连接框架（多个用空格分隔编号） =="
        while [ $((i * 3 - 2)) -le ${#items[@]} ]; do
            ids+=("${items[$((i * 3 - 3))]}")
            echo "  $i) ${items[$((i * 3 - 2))]} [$([ "${items[$((i * 3 - 1))]}" = on ] && echo 已选 || echo 未选)]"
            i=$((i + 1))
        done
        read -r -p "选择: " sel
        for n in $sel; do
            [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -le "${#ids[@]}" ] && picked+="${ids[$((n - 1))]}"$'\n'"on"$'\n'
        done
        printf '%s' "$picked"
    else
        nt_capture dialog --title "连接框架" --checklist \
            "空格切换 · 同一 QQ 可同时连接多个框架" 16 68 8 "${items[@]}"
    fi
}

nt_links_from_checklist() {
    local qq="$1" checklist="$2" old links='[]' id checked fw port
    old="$(napcat_load_qq_config "${QQ_DIR}/qq_${qq}.json" 2>/dev/null | jq -c '.links // []')"
    while read -r id checked; do
        [ -z "$id" ] || [ "$checked" != "on" ] && continue
        fw="$(napcat_get_framework "$id")"; [ -z "$fw" ] && continue
        port="$(echo "$old" | jq -r --arg id "$id" '.[]|select(.framework_id==$id)|.port//empty' | head -n1)"
        [ -z "$port" ] && port="$(echo "$fw" | jq -r '.default_port')"
        token="$(echo "$old" | jq -r --arg id "$id" '.[]|select(.framework_id==$id)|.token//""' | head -n1)"
        links="$(jq -n --argjson a "$links" --arg id "$id" --argjson port "$port" --arg token "$token" \
            '$a + [{framework_id:$id,enabled:true,port:$port,token:$token}]')"
    done <<< "$checklist"
    printf '%s' "$links"
}

nt_tune_link_ports() {
    local links="$1" out='[]' link id fw label port new_port
    while IFS= read -r link; do
        [ -z "$link" ] && continue
        id="$(echo "$link" | jq -r '.framework_id')"
        fw="$(napcat_get_framework "$id")"
        label="$(echo "$fw" | jq -r '.label // .id')"
        port="$(echo "$link" | jq -r '.port')"
        new_port="$(nt_input "$label 监听端口" 8 50 "$port")" || return 1
        [[ -z "$new_port" ]] && new_port="$port"
        link="$(echo "$link" | jq --argjson port "$new_port" '.port=$port')"
        out="$(jq -n --argjson a "$out" --argjson l "$link" '$a + [$l]')"
    done < <(echo "$links" | jq -c '.[]')
    printf '%s' "$out"
}

nt_save_qq() {
    local qq="$1" links="$2" ob_token="${3:-}" old_qq="${4:-}"
    jq -n --arg qq "$qq" --arg ob "$ob_token" --argjson links "$links" \
        '{qq:$qq,ob_token:$ob,links:$links,console_log:true,file_log:false}' \
        > "${QQ_DIR}/qq_${qq}.json"
    [ -n "$old_qq" ] && [ "$old_qq" != "$qq" ] && rm -f "${QQ_DIR}/qq_${old_qq}.json"
}

nt_qq_wizard() {
    local title="$1" old_qq="${2:-}" cf qq ob checklist links
    cf="${QQ_DIR}/qq_${old_qq}.json"
    [ -n "$old_qq" ] && [ -f "$cf" ] || cf=""

    if nt_use_text; then
        qq="$(nt_input "QQ 账号" 1 36 "${old_qq:-}")" || return 1
        ob="$(nt_input "全局 Token（可空）" 1 36 "$([ -f "$cf" ] && jq -r '.ob_token' "$cf" || echo '')")"
    else
        values="$(nt_capture dialog --title "$title" --form "全局 Token 留空则各框架用各自 api_key" 11 58 2 \
            "QQ 账号:" 1 1 "${old_qq:-}" 1 12 36 0 \
            "全局Token:" 2 1 "$([ -f "$cf" ] && jq -r '.ob_token' "$cf" || echo '')" 2 12 36 0)" \
            || return 1
        qq=$(echo "$values" | sed -n1p | tr -d '[:space:]')
        ob=$(echo "$values" | sed -n2p)
    fi
    [[ -z "$qq" ]] && return 1

    checklist="$(nt_pick_frameworks "$qq")" || return 1
    links="$(nt_links_from_checklist "$qq" "$checklist")"
    [ "$(echo "$links" | jq 'length')" -eq 0 ] && { nt_msg "请至少选择一个框架"; return 1; }

    if nt_yesno "为每个框架确认端口？" 7 40; then
        links="$(nt_tune_link_ports "$links")" || return 1
    fi

    nt_save_qq "$qq" "$links" "$ob" "$old_qq"
    printf '%s' "$qq"
}

nt_show_framework_menu() {
    napcat_refresh_frameworks >/dev/null
    local items=() sel id label port
    while IFS='|' read -r id label port; do
        [ -z "$id" ] && continue
        items+=("$id" "$label :$port")
    done < <(nt_framework_items)

    if [ ${#items[@]} -eq 0 ]; then
        sel="$(nt_menu "框架" 10 50 3 \
            "scan" "扫描磁盘" "add" "手动添加" "back" "返回")" || return
        case "$sel" in scan) napcat_refresh_frameworks; nt_msg "扫描完成" 5 ;; add) nt_add_framework ;; esac
        nt_show_framework_menu; return
    fi

    sel="$(nt_menu "框架管理" 16 64 10 \
        "scan" "重新扫描" "add" "添加目录" "port" "改默认端口" "del" "移除框架" "back" "返回主菜单" \
        "${items[@]}")" || return

    case "$sel" in
        scan) napcat_refresh_frameworks; nt_msg "扫描完成" 5; nt_show_framework_menu ;;
        add) nt_add_framework ;;
        port) nt_edit_framework_port ;;
        del) nt_del_framework ;;
        back) return ;;
        *)
            nt_msg "$(napcat_get_framework "$sel" | jq -r \
                '"名称: \(.label)\n目录: \(.root)\n端口: \(.default_port)\n密钥: \(.root)/config/server_config/api_key.json"')" \
                10 60
            nt_show_framework_menu ;;
    esac
}

nt_add_framework() {
    local path port label id prefs fw
    path="$(nt_input "框架根目录" 10 58 "$HOME")" || return
    [ -d "$path" ] || return
    port="$(nt_input "默认端口" 8 42 "$(napcat_guess_framework_port "$path")")" || return
    label="$(napcat_framework_label "$path")"
    id="$(napcat_framework_id_from_root "$path")"
    fw="$(jq -n --arg id "$id" --arg label "$label" --arg root "$path" --argjson port "$port" \
        '{id:$id,label:$label,root:$root,default_port:$port,ws_host:"127.0.0.1",ws_path:"OneBotv11"}')"
    prefs="$(napcat_load_prefs)"
    napcat_save_prefs "$(echo "$prefs" | jq --argjson fw "$fw" \
        '.frameworks = ([.frameworks[]|select(.root!=$fw.root)] + [$fw])')"
    nt_msg "已添加 $label" 6
    nt_show_framework_menu
}

nt_edit_framework_port() {
    local items=() id sel port prefs
    while IFS='|' read -r id label p; do items+=("$id" "$label"); done < <(nt_framework_items)
    id="$(nt_menu "改端口" 12 50 6 "${items[@]}")" || return
    port="$(nt_input "新默认端口" 8 42 \
        "$(napcat_get_framework "$id" | jq -r '.default_port')")" || return
    prefs="$(napcat_load_prefs)"
    napcat_save_prefs "$(echo "$prefs" | jq --arg id "$id" --argjson port "$port" \
        '.frameworks = [.frameworks[]|if .id==$id then .default_port=$port else . end]')"
    nt_show_framework_menu
}

nt_del_framework() {
    local items=() id sel prefs
    while IFS='|' read -r id label _; do items+=("$id" "$label"); done < <(nt_framework_items)
    id="$(nt_menu "移除框架" 12 50 6 "${items[@]}")" || return
    nt_yesno "确认移除？" 6 30 || return
    prefs="$(napcat_load_prefs)"
    napcat_save_prefs "$(echo "$prefs" | jq --arg id "$id" '.frameworks = [.frameworks[]|select(.id!=$id)]')"
    nt_show_framework_menu
}

# ── WebUI ─────────────────────────────────────────
nt_show_webui_menu() {
    local prefs webui values h p t r dp show_token
    prefs="$(napcat_load_prefs)"
    webui="$(napcat_read_webui_file)"
    show_token="$(echo "$prefs" | jq -r '.webui_token // ""')"
    [ -z "$show_token" ] && show_token="$(echo "$webui" | jq -r '.token // ""')"

    if nt_use_text; then
        h="$(nt_input "监听地址" 1 44 "$(echo "$prefs" | jq -r '.webui_host')")"
        p="$(nt_input "端口 (0=关闭)" 1 44 "$(echo "$prefs" | jq -r '.webui_port')")"
        t="$(nt_input "Token (可空)" 1 44 "$show_token")"
        r="$(nt_input "限速/分" 1 44 "$(echo "$prefs" | jq -r '.login_rate')")"
        dp="$(nt_input "禁用pty (yes/no)" 1 44 "$(echo "$prefs" | jq 'if .disable_pty then "yes" else "no" end' -r)")"
    else
        values="$(nt_capture dialog --title "WebUI" --form \
            "端口 0=关闭 · Token 留空则由 NapCat 启动时生成" 18 68 5 \
            "监听地址:" 1 1 "$(echo "$prefs" | jq -r '.webui_host')" 1 14 44 0 \
            "端口:"     2 1 "$(echo "$prefs" | jq -r '.webui_port')" 2 14 44 0 \
            "Token:"    3 1 "$show_token" 3 14 44 0 \
            "限速/分:"  4 1 "$(echo "$prefs" | jq -r '.login_rate')" 4 14 44 0 \
            "禁用pty:"  5 1 "$(echo "$prefs" | jq 'if .disable_pty then "yes" else "no" end' -r)" 5 14 44 0)" \
            || return
        h=$(echo "$values" | sed -n1p | tr -d '[:space:]')
        p=$(echo "$values" | sed -n2p | tr -d '[:space:]')
        t=$(echo "$values" | sed -n3p)
        r=$(echo "$values" | sed -n4p | tr -d '[:space:]')
        dp=$(echo "$values" | sed -n5p)
    fi
    [[ -z "$h" ]] && h="127.0.0.1"
    [[ -z "$p" ]] && p=6099
    [[ -z "$r" ]] && r=3

    napcat_save_prefs "$(echo "$prefs" | jq \
        --arg h "$h" --argjson p "$p" --arg t "$t" --argjson r "$r" \
        --argjson dp "$(nt_yes "$dp" && echo true || echo false)" \
        '.webui_host=$h|.webui_port=$p|.webui_token=$t|.login_rate=$r|.disable_pty=$dp')"
    napcat_apply_webui
    nt_msg "WebUI 已写入 webui.json\nhttp://${h}:${p}/webui" 8
}

# ── 状态总览 ─────────────────────────────────────
nt_show_status() {
    local text prefs wf qq
    prefs="$(napcat_load_prefs)"
    text="══ NapCat 状态 ══\n\n[ WebUI ]\n"
    text+="  $(echo "$prefs" | jq -r '.webui_host'):$(echo "$prefs" | jq -r '.webui_port')"
    text+="$(echo "$prefs" | jq -r 'if .webui_token!="" then " token=已设" else " token=自动" end')\n"
    text+="\n[ 框架 $(echo "$prefs" | jq '.frameworks|length') 个 ]\n"
    while IFS= read -r fw; do
        text+="  · $(echo "$fw" | jq -r '.label') :$(echo "$fw" | jq -r '.default_port')\n"
        text+="    $(echo "$fw" | jq -r '.root')\n"
    done < <(echo "$prefs" | jq -c '.frameworks[]?')
    text+="\n[ QQ 账号 ]\n"
    for qq in $(find "$QQ_DIR" -maxdepth 1 -name 'qq_*.json' -exec basename {} \; | sed 's/^qq_//;s/.json$//'); do
        text+="  $qq → "
        text+="$(jq -r '.links[]|select(.enabled)|.framework_id' "${QQ_DIR}/qq_${qq}.json" | tr '\n' ',' | sed 's/,$//')\n"
    done
    if nt_use_text; then
        printf '%b\n' "$text"; read -r -p "按回车返回…" _
    else
        nt_capture dialog --title "状态" --textbox - 22 68 <<< "$(printf '%b' "$text")"
    fi
}

# ── 启动 ─────────────────────────────────────────
nt_start_qq() {
    local qq="$1" qf="${QQ_DIR}/qq_${qq}.json" cfg prefs
    [ -f "$qf" ] || { echo "无配置 $qf"; exit 1; }
    napcat_prepare_runtime "$qq" "$qf"
    cfg="$(napcat_load_qq_config "$qf")"
    prefs="$(napcat_load_prefs)"
    clear; killall dialog 2>/dev/null
    echo "┌─ NapCat 启动 ─────────────────"
    echo "│ QQ: $qq"
    while IFS= read -r link; do
        [ -z "$link" ] && continue
        local id fw lbl h p path
        id="$(echo "$link" | jq -r '.framework_id')"
        fw="$(napcat_get_framework "$id")"
        lbl="$(echo "$fw" | jq -r '.label // .id')"
        h="$(echo "$fw" | jq -r '.ws_host')"
        p="$(echo "$link" | jq -r '.port')"
        path="$(echo "$fw" | jq -r '.ws_path' | sed 's#^/##')"
        echo "│ → $lbl  ws://${h}:${p}/${path}"
    done < <(echo "$cfg" | jq -c '.links[]|select(.enabled==true)')
  if [ "$(echo "$prefs" | jq -r '.webui_port')" = "0" ]; then
        echo "│ WebUI: 关闭"
    else
        echo "│ WebUI: http://$(echo "$prefs" | jq -r '.webui_host'):$(echo "$prefs" | jq -r '.webui_port')/webui"
    fi
    echo "└──────────────────────────────"
    xvfb-run -a qq --no-sandbox -q "$qq"
    exit 0
}

# ── 主菜单 ───────────────────────────────────────
nt_main_menu() {
    local sel st
    nt_use_text && echo "[nt] 文本模式（检测到 xterminal，dialog 不可用；MobaXterm 等可用 NT_FORCE_DIALOG=1 强制图形）"
    while true; do
        if nt_use_text; then
            sel="$(nt_menu "NapCat 主菜单" 18 58 10 \
                "add"    "新增 QQ（可多选框架）" \
                "edit"   "修改 / 删除 QQ" \
                "start"  "启动 QQ" \
                "fw"     "框架管理" \
                "webui"  "WebUI（地址/端口/Token）" \
                "status" "查看当前配置" \
                "audit"  "安全审计" \
                "quit"   "退出")" || exit 0
        else
            sel="$(nt_capture dialog --title "主菜单" --menu \
                "多 QQ · 多框架 · 安全加固" 18 58 10 \
                "add"    "新增 QQ（可多选框架）" \
                "edit"   "修改 / 删除 QQ" \
                "start"  "启动 QQ" \
                "fw"     "框架管理" \
                "webui"  "WebUI（地址/端口/Token）" \
                "status" "查看当前配置" \
                "audit"  "安全审计" \
                "quit"   "退出")"
            st=$?
            [ "$st" -eq 0 ] || { [ "$st" -eq 1 ] && exit 0
                echo "[nt] dialog 无法启动 (exit=$st TERM=${TERM:-未设置})，请用: NT_UI=text nt" >&2
                exit 1
            }
        fi
        case "$sel" in
            add)
                local qq; qq="$(nt_qq_wizard "新增 QQ")" || continue
                nt_yesno "立即启动 $qq？" 6 32 && nt_start_qq "$qq"
                ;;
            edit) nt_edit_qq ;;
            start) nt_pick_start ;;
            fw) nt_show_framework_menu ;;
            webui) nt_show_webui_menu ;;
            status) nt_show_status ;;
            audit) napcat_security_audit; read -r -p "回车继续…" _ ;;
            quit) exit 0 ;;
        esac
    done
}

nt_edit_qq() {
    local items=() qq sel
    for qq in $(find "$QQ_DIR" -maxdepth 1 -name 'qq_*.json' -exec basename {} \; | sed 's/^qq_//;s/.json$//'); do
        items+=("$qq" "$(jq -r '.links[]|select(.enabled)|.framework_id' "${QQ_DIR}/qq_${qq}.json" | paste -sd, -)")
    done
    [ ${#items[@]} -eq 0 ] && { nt_msg "暂无 QQ 配置"; return; }

    sel="$(nt_menu "编辑 QQ" 14 55 8 \
        "_edit" "修改配置" "_del" "删除账号" "_back" "返回")" || return
    case "$sel" in
        _back) return ;;
        _del)
            sel="$(nt_menu "删除 QQ" 12 45 6 "${items[@]}")" || return
            nt_yesno "删除 qq_${sel}.json？" 6 34 || return
            rm -f "${QQ_DIR}/qq_${sel}.json"; nt_msg "已删除" 5
            ;;
        _edit)
            sel="$(nt_menu "修改 QQ" 14 55 8 "${items[@]}")" || return
            nt_qq_wizard "修改 $sel" "$sel" || return
            nt_msg "已保存" 5
            ;;
    esac
}

nt_pick_start() {
    local items=() sel
    for qq in $(find "$QQ_DIR" -maxdepth 1 -name 'qq_*.json' -exec basename {} \; | sed 's/^qq_//;s/.json$//'); do
        items+=("$qq" "启动")
    done
    [ ${#items[@]} -eq 0 ] && { nt_msg "暂无 QQ"; return; }
    sel="$(nt_menu "启动 QQ" 12 40 8 "${items[@]}")" || return
    nt_start_qq "$sel"
}

main() {
    case "${1:-}" in
        --text|-t) NT_UI=text; shift ;;
        -h|--help)
            echo "  nt           管理菜单"
            echo "  nt <QQ>      启动已配置账号"
            echo "  nt --audit   安全审计"
            echo "  nt --text    文本菜单（xterminal 等）"
            exit 0 ;;
    esac
    nt_deps
    case "${1:-}" in
        --audit|-a) napcat_security_audit; exit $? ;;
    esac
    if [ -n "${1:-}" ]; then
        [ -f "${QQ_DIR}/qq_${1}.json" ] || { echo "无 qq_${1}.json，请先运行 nt 配置"; exit 1; }
        nt_start_qq "$1"
    else
        nt_main_menu
    fi
}

main "$@"
