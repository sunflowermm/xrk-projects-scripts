#!/bin/bash
# NapCat 管理：多 QQ · 多框架 · WebUI
root="${XRK_ROOT:-/xrk}"
# shellcheck source=/dev/null
source "${root}/shell_modules/xrk_base.sh"
xrk_加载底层 install
# shellcheck source=/dev/null
source "${root}/shell_modules/napcat_security.sh"

QQ_DIR="$root/body"
NT_BACK=" XRK · NapCat 管理 "
NT_LOG="${NT_LOG:-/tmp/nt.log}"

nt_log() {
    printf '[%s] %s\n' "$(date '+%F %T')" "$1" >> "$NT_LOG"
}

nt_deps() {
    for p in jq dialog xvfb-run; do
        command -v "$p" &>/dev/null || {
            type install_pkg &>/dev/null && install_pkg "$p" || { echo "缺少 $p"; exit 1; }
        }
    done
}

# 菜单/表单：当前 shell 直接调用（禁止 $(nt_dialog_run ...)）
nt_dialog_run() {
    local __var=$1; shift
    exec 3>&1
    local __out __st
    __out=$(dialog --backtitle "$NT_BACK" "$@" 2>&1 1>&3)
    __st=$?
    exec 3>&-
    printf -v "$__var" '%s' "$__out"
    return "$__st"
}

nt_dialog_input_run() {
    local __var=$1; shift
    local __out __st
    __out=$(dialog --backtitle "$NT_BACK" "$@" 2>&1 >/dev/tty)
    __st=$?
    printf -v "$__var" '%s' "$__out"
    return "$__st"
}

nt_yes() { case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in y|yes|1|true|是) return 0 ;; *) return 1 ;; esac; }

nt_msg() {
    nt_log "INFO: $1"
    dialog --backtitle "$NT_BACK" --title "提示" --msgbox "$1" "${2:-8}" "${3:-52}" 2>/dev/null \
        || echo "[nt] $1" >&2
}

nt_err() {
    nt_log "ERROR: $1"
    echo "[nt ERROR] $1" >&2
    dialog --backtitle "$NT_BACK" --title "错误" --msgbox "$1" "${2:-10}" "${3:-58}" 2>/dev/null \
        || echo "[nt ERROR] $1" >&2
}

nt_napcat_running() {
    pgrep -f '[q]q --no-sandbox' >/dev/null 2>&1 \
        || pgrep -f '[N]apCat' >/dev/null 2>&1 \
        || pgrep -f '/opt/QQ/' >/dev/null 2>&1
}

# dialog --form 默认值不能含换行/双引号，否则对话框直接失败且 stderr 被吞
nt_form_default() {
    printf '%s' "$1" | tr -d '\r\n' | tr '"' "'"
}

nt_yesno() {
    nt_dialog_run _nt_yesno_dummy --yesno "$1" "${2:-7}" "${3:-40}"
}

nt_framework_items() {
    napcat_load_prefs | jq -r '.frameworks[]? | "\(.id)|\(.label)|\(.default_port)"'
}

nt_pick_frameworks() {
    local __var=$1 qq="$2" items=() id label port state old="" checklist
    [ -f "${QQ_DIR}/qq_${qq}.json" ] && \
        old="$(jq -r '.links[]?|select(.enabled)|.framework_id' "${QQ_DIR}/qq_${qq}.json" 2>/dev/null || true)"
    while IFS='|' read -r id label port; do
        [ -z "$id" ] && continue
        state=off; echo "$old" | grep -qxF "$id" && state=on
        items+=("$id" "$label · :$port" "$state")
    done < <(nt_framework_items)
    [ ${#items[@]} -eq 0 ] && { nt_msg "请先在「框架管理」扫描或添加框架" 7; return 1; }
    nt_dialog_input_run checklist --title "连接框架" --checklist \
        "空格切换 · 回车确认 · 可同时选多个框架" 16 68 8 "${items[@]}" || return 1
    printf -v "$__var" '%s' "$checklist"
}

nt_links_from_checklist() {
    local qq="$1" checklist="$2" old links='[]' id checked fw port token
    old='[]'
    [ -f "${QQ_DIR}/qq_${qq}.json" ] && old="$(jq -c '.links // []' "${QQ_DIR}/qq_${qq}.json")"
    while read -r id checked; do
        [ -z "$id" ] || [ "$checked" != "on" ] && continue
        fw="$(napcat_get_framework "$id")"; [ -z "$fw" ] && continue
        port="$(echo "$old" | jq -r --arg id "$id" '.[]|select(.framework_id==$id)|.port//empty' | head -n1)"
        [ -z "$port" ] && port="$(echo "$fw" | jq -r '.default_port')"
        token="$(echo "$old" | jq -r --arg id "$id" '.[]|select(.framework_id==$id)|.token//""' | head -n1)"
        links="$(jq -n --argjson a "$links" --arg id "$id" --argjson port "$port" --arg token "$token" \
            '$a + [{framework_id:$id,enabled:true,port:$port,token:$token}]')"
    done <<< "$checklist"
    printf '%s' "$links"
}

nt_tune_link_ports() {
    local links="$1" out='[]' link id fw label port new_port
    while IFS= read -r link; do
        [ -z "$link" ] && continue
        id="$(echo "$link" | jq -r '.framework_id')"
        fw="$(napcat_get_framework "$id")"
        label="$(echo "$fw" | jq -r '.label // .id')"
        port="$(echo "$link" | jq -r '.port')"
        nt_dialog_input_run new_port --inputbox "$label 监听端口" 8 50 "$port" || return 1
        [[ -z "$new_port" ]] && new_port="$port"
        link="$(echo "$link" | jq --argjson port "$new_port" '.port=$port')"
        out="$(jq -n --argjson a "$out" --argjson l "$link" '$a + [$l]')"
    done < <(echo "$links" | jq -c '.[]')
    printf '%s' "$out"
}

nt_save_qq() {
    local qq="$1" links="$2" ob_token="${3:-}" old_qq="${4:-}"
    jq -n --arg qq "$qq" --arg ob "$ob_token" --argjson links "$links" \
        '{qq:$qq,ob_token:$ob,links:$links,console_log:true,file_log:false}' \
        > "${QQ_DIR}/qq_${qq}.json"
    [ -n "$old_qq" ] && [ "$old_qq" != "$qq" ] && rm -f "${QQ_DIR}/qq_${old_qq}.json"
}

nt_qq_wizard() {
    local __ret=$1 title="$2" old_qq="${3:-}" cf values qq ob checklist links
    cf="${QQ_DIR}/qq_${old_qq}.json"
    [ -n "$old_qq" ] && [ -f "$cf" ] || cf=""

    nt_dialog_run values --title "$title" --form \
        "第1步：填写 QQ · 点 OK 进入第2步勾选框架" 11 58 2 \
        "QQ 账号:" 1 1 "${old_qq:-}" 1 12 36 0 \
        "全局Token:" 2 1 "$([ -f "$cf" ] && jq -r '.ob_token' "$cf" || echo '')" 2 12 36 0 \
        || return 1
    qq=$(echo "$values" | sed -n1p | tr -d '[:space:]')
    ob=$(echo "$values" | sed -n2p)
    [[ -z "$qq" ]] && return 1

    nt_pick_frameworks checklist "$qq" || return 1
    links="$(nt_links_from_checklist "$qq" "$checklist")"
    [ "$(echo "$links" | jq 'length')" -eq 0 ] && { nt_msg "请至少选择一个框架"; return 1; }

    if nt_yesno "为每个框架确认端口？" 7 40; then
        links="$(nt_tune_link_ports "$links")" || return 1
    fi

    nt_save_qq "$qq" "$links" "$ob" "$old_qq"
    printf -v "$__ret" '%s' "$qq"
}

nt_show_framework_menu() {
    napcat_refresh_frameworks >/dev/null
    local items=() sel
    while IFS='|' read -r id label port; do
        [ -z "$id" ] && continue
        items+=("$id" "$label :$port")
    done < <(nt_framework_items)

    if [ ${#items[@]} -eq 0 ]; then
        nt_dialog_run sel --title "框架" --menu "未扫描到框架" 10 50 3 \
            "scan" "扫描磁盘" "add" "手动添加" "back" "返回" || return
        case "$sel" in scan) napcat_refresh_frameworks; nt_msg "扫描完成" 5 ;; add) nt_add_framework ;; esac
        nt_show_framework_menu; return
    fi

    nt_dialog_run sel --title "框架管理" --menu "已注册框架" 16 64 10 \
        "scan" "重新扫描" "add" "添加目录" "port" "改默认端口" "del" "移除框架" "back" "返回主菜单" \
        "${items[@]}" || return

    case "$sel" in
        scan) napcat_refresh_frameworks; nt_msg "扫描完成" 5; nt_show_framework_menu ;;
        add) nt_add_framework ;;
        port) nt_edit_framework_port ;;
        del) nt_del_framework ;;
        back) return ;;
        *)
            nt_msg "$(napcat_get_framework "$sel" | jq -r \
                '"名称: \(.label)\n目录: \(.root)\n端口: \(.default_port)\n密钥: \(.root)/config/server_config/api_key.json"')" \
                10 60
            nt_show_framework_menu ;;
    esac
}

nt_add_framework() {
    local path port label id prefs fw
    nt_dialog_input_run path --inputbox "框架根目录" 10 58 "$HOME" || return
    [ -d "$path" ] || return
    nt_dialog_input_run port --inputbox "默认端口" 8 42 "$(napcat_guess_framework_port "$path")" || return
    label="$(napcat_framework_label "$path")"
    id="$(napcat_framework_id_from_root "$path")"
    fw="$(jq -n --arg id "$id" --arg label "$label" --arg root "$path" --argjson port "$port" \
        '{id:$id,label:$label,root:$root,default_port:$port,ws_host:"127.0.0.1",ws_path:"OneBotv11"}')"
    prefs="$(napcat_load_prefs)"
    napcat_save_prefs "$(echo "$prefs" | jq --argjson fw "$fw" \
        '.frameworks = ([.frameworks[]|select(.root!=$fw.root)] + [$fw])')"
    nt_msg "已添加 $label" 6
    nt_show_framework_menu
}

nt_edit_framework_port() {
    local items=() id port prefs
    while IFS='|' read -r id label _; do items+=("$id" "$label"); done < <(nt_framework_items)
    nt_dialog_run id --title "改端口" --menu "选择框架" 12 50 6 "${items[@]}" || return
    nt_dialog_input_run port --inputbox "新默认端口" 8 42 \
        "$(napcat_get_framework "$id" | jq -r '.default_port')" || return
    prefs="$(napcat_load_prefs)"
    napcat_save_prefs "$(echo "$prefs" | jq --arg id "$id" --argjson port "$port" \
        '.frameworks = [.frameworks[]|if .id==$id then .default_port=$port else . end]')"
    nt_show_framework_menu
}

nt_del_framework() {
    local items=() id prefs
    while IFS='|' read -r id label _; do items+=("$id" "$label"); done < <(nt_framework_items)
    nt_dialog_run id --title "移除" --menu "选择框架" 12 50 6 "${items[@]}" || return
    nt_yesno "确认移除？" 6 30 || return
    prefs="$(napcat_load_prefs)"
    napcat_save_prefs "$(echo "$prefs" | jq --arg id "$id" '.frameworks = [.frameworks[]|select(.id!=$id)]')"
    nt_show_framework_menu
}

nt_show_webui_menu() {
    local prefs values h p t r dp show_token st new_prefs wf eff

    if nt_napcat_running; then
        nt_err "NapCat/QQ 正在运行\n\n运行中 WebUI 会按内存配置写回 webui.json\n请先 killall qq 或退出 NapCat 再改\n\n日志: $NT_LOG" 12
        return 1
    fi

    prefs="$(napcat_load_prefs)" || true
    if [ -n "${NAPCAT_LAST_ERR:-}" ]; then
        nt_err "加载配置时出现问题（已用默认值继续）\n${NAPCAT_LAST_ERR}\n\n日志: $NT_LOG" 10
        NAPCAT_LAST_ERR=""
    fi
    [ -z "$prefs" ] && { nt_err "无法加载 napcat_prefs.json\n日志: $NT_LOG"; return 1; }

    eff="$(napcat_webui_effective)"
    show_token="$(echo "$eff" | jq -r '.token // ""')"
    show_token="$(nt_form_default "$show_token")"

    nt_dialog_run values --title "WebUI（全局）" --form \
        "读取 webui.json · 仅改 host/port/token/loginRate · 保留 theme 等" 18 68 5 \
        "监听地址:" 1 1 "$(nt_form_default "$(echo "$eff" | jq -r '.host')")" 1 14 44 0 \
        "端口:"     2 1 "$(nt_form_default "$(echo "$eff" | jq -r '.port')")" 2 14 44 0 \
        "Token:"    3 1 "$show_token" 3 14 44 0 \
        "限速/分:"  4 1 "$(nt_form_default "$(echo "$eff" | jq -r '.loginRate')")" 4 14 44 0 \
        "禁用pty:"  5 1 "$(nt_form_default "$(echo "$prefs" | jq 'if .disable_pty then "yes" else "no" end' -r)")" 5 14 44 0
    st=$?
    case $st in
        0) ;;
        1) return 0 ;;
        *) nt_err "对话框打开失败 (exit=$st)\n${values:-请检查 Token 是否含特殊字符}\n日志: $NT_LOG" 10; return 1 ;;
    esac

    h=$(echo "$values" | sed -n1p | tr -d '[:space:]')
    p=$(echo "$values" | sed -n2p | tr -d '[:space:]')
    t=$(echo "$values" | sed -n3p | tr -d '\r\n')
    r=$(echo "$values" | sed -n4p | tr -d '[:space:]')
    dp=$(echo "$values" | sed -n5p)
    [[ -z "$h" ]] && h="127.0.0.1"
    [[ -z "$p" ]] && p=6099
    [[ -z "$r" ]] && r=3
    [[ "$p" =~ ^[0-9]+$ ]] || { nt_err "端口须为数字：$p"; return 1; }
    [[ "$r" =~ ^[0-9]+$ ]] || { nt_err "限速须为数字：$r"; return 1; }

    if ! new_prefs="$(echo "$prefs" | jq \
        --arg h "$h" --argjson p "$p" --arg t "$t" --argjson r "$r" \
        --argjson dp "$(nt_yes "$dp" && echo true || echo false)" \
        '.webui_host=$h|.webui_port=$p|.webui_token=$t|.login_rate=$r|.disable_pty=$dp' 2>&1)"; then
        nt_err "合并配置失败\n${new_prefs}\n日志: $NT_LOG" 12
        return 1
    fi
    napcat_save_prefs "$new_prefs" || {
        nt_err "保存 napcat_prefs 失败\n${NAPCAT_LAST_ERR:-$(napcat_prefs_path)}\n日志: $NT_LOG" 12
        return 1
    }
    napcat_apply_webui || {
        wf="$(napcat_webui_file)"
        nt_err "写入 webui.json 失败\n${NAPCAT_LAST_ERR:-}\n\n目标: $wf\n日志: $NT_LOG" 14
        return 1
    }
    wf="$(napcat_webui_file)"
    if url="$(napcat_webui_url 2>/dev/null)"; then
        nt_msg "WebUI 已合并写入\n${url}\n\n保留 theme 等字段\n文件: $wf\n日志: $NT_LOG" 12
    else
        nt_msg "WebUI 已关闭（port=0）\n$wf\n日志: $NT_LOG" 8
    fi
}

nt_webui_apply_cli() {
    local prefs wf
    if nt_napcat_running; then
        echo "[nt] NapCat/QQ 正在运行，请先 stop 再改 WebUI" >&2
        return 1
    fi
    prefs="$(napcat_load_prefs)" || true
    [ -z "$prefs" ] && { echo "[nt] 无法加载 napcat_prefs" >&2; return 1; }
    napcat_apply_webui || {
        echo "[nt] ${NAPCAT_LAST_ERR:-apply failed}" >&2
        return 1
    }
    wf="$(napcat_webui_file)"
    echo "[nt] OK merged -> $wf"
    jq -c '{host,port,token,loginRate,disableWebUI,hasTheme:(.theme!=null)}' "$wf"
}

nt_show_status() {
    local tmp
    tmp="$(mktemp "${TMPDIR:-/tmp}/nt_status.XXXXXX")"
    napcat_status_text > "$tmp"
    dialog --backtitle "$NT_BACK" --title "状态" --textbox "$tmp" 22 68
    rm -f "$tmp"
}

nt_start_qq() {
    local qq="$1" qf="${QQ_DIR}/qq_${qq}.json" cfg url
    [ -f "$qf" ] || { echo "无配置 $qf"; exit 1; }
    napcat_prepare_runtime "$qq" "$qf"
    cfg="$(jq -c . "$qf")"
    clear; killall dialog 2>/dev/null
    echo "┌─ NapCat 启动 ─────────────────"
    echo "│ QQ: $qq"
    while IFS= read -r link; do
        [ -z "$link" ] && continue
        local id fw lbl h p path
        id="$(echo "$link" | jq -r '.framework_id')"
        fw="$(napcat_get_framework "$id")"
        lbl="$(echo "$fw" | jq -r '.label // .id')"
        h="$(echo "$fw" | jq -r '.ws_host')"
        p="$(echo "$link" | jq -r '.port')"
        path="$(echo "$fw" | jq -r '.ws_path' | sed 's#^/##')"
        echo "│ → $lbl  ws://${h}:${p}/${path}"
    done < <(echo "$cfg" | jq -c '.links[]|select(.enabled==true)')
    if url="$(napcat_webui_url 2>/dev/null)"; then
        echo "│ WebUI（全局）: $url"
    else
        echo "│ WebUI: 关闭"
    fi
    echo "└──────────────────────────────"
    xvfb-run -a qq --no-sandbox -q "$qq"
    exit 0
}

nt_main_menu() {
    local sel st qq
    while true; do
        nt_dialog_run sel --clear --title "主菜单" --menu \
            "多 QQ · 多框架" 18 58 8 \
            "add"    "新增 QQ（可多选框架）" \
            "edit"   "修改 / 删除 QQ" \
            "start"  "启动 QQ" \
            "fw"     "框架管理" \
            "webui"  "WebUI（全局 · 地址/Token）" \
            "status" "查看当前配置" \
            "quit"   "退出"
        st=$?
        case "$st" in
            0) ;;
            1|255) exit 0 ;;
            *) echo "[nt] dialog 失败 (exit=$st TERM=${TERM:-?})" >&2; exit 1 ;;
        esac
        case "$sel" in
            add)
                nt_qq_wizard qq "新增 QQ" || continue
                nt_yesno "立即启动 $qq？" 6 32 && nt_start_qq "$qq"
                ;;
            edit) nt_edit_qq ;;
            start) nt_pick_start ;;
            fw) nt_show_framework_menu ;;
            webui) nt_show_webui_menu ;;
            status) nt_show_status ;;
            quit) exit 0 ;;
        esac
    done
}

nt_edit_qq() {
    local items=() qq sel
    for qq in $(find "$QQ_DIR" -maxdepth 1 -name 'qq_*.json' -exec basename {} \; | sed 's/^qq_//;s/.json$//'); do
        items+=("$qq" "$(napcat_qq_links_summary "${QQ_DIR}/qq_${qq}.json")")
    done
    [ ${#items[@]} -eq 0 ] && { nt_msg "暂无 QQ 配置"; return; }

    nt_dialog_run sel --title "编辑 QQ" --menu "选择操作" 14 55 8 \
        "_edit" "修改配置" "_del" "删除账号" "_back" "返回" || return
    case "$sel" in
        _back) return ;;
        _del)
            nt_dialog_run sel --title "删除" --menu "选择 QQ" 12 45 6 "${items[@]}" || return
            nt_yesno "删除 qq_${sel}.json？" 6 34 || return
            rm -f "${QQ_DIR}/qq_${sel}.json"; nt_msg "已删除" 5
            ;;
        _edit)
            nt_dialog_run sel --title "修改" --menu "选择 QQ" 14 55 8 "${items[@]}" || return
            nt_qq_wizard _qq_dummy "修改 $sel" "$sel" || return
            nt_msg "已保存" 5
            ;;
    esac
}

nt_pick_start() {
    local items=() sel
    for qq in $(find "$QQ_DIR" -maxdepth 1 -name 'qq_*.json' -exec basename {} \; | sed 's/^qq_//;s/.json$//'); do
        items+=("$qq" "启动")
    done
    [ ${#items[@]} -eq 0 ] && { nt_msg "暂无 QQ"; return; }
    nt_dialog_run sel --title "启动" --menu "选择 QQ" 12 40 8 "${items[@]}" || return
    nt_start_qq "$sel"
}

main() {
    nt_deps
    case "${1:-}" in
        -h|--help)
            echo "  nt              管理菜单"
            echo "  nt <QQ>         启动已配置账号"
            echo "  nt --webui-apply  将 napcat_prefs 合并写入 webui.json（需先停 NapCat）"
            echo "  日志: ${NT_LOG}"
            exit 0 ;;
        --webui-apply) nt_webui_apply_cli; exit $? ;;
    esac
    if [ -n "${1:-}" ]; then
        [ -f "${QQ_DIR}/qq_${1}.json" ] || { echo "无 qq_${1}.json，请先运行 nt 配置"; exit 1; }
        nt_start_qq "$1"
    else
        nt_main_menu
    fi
}

main "$@"
