#!/bin/bash
# xm：脚本入口（换源 / 安装脚本仓库 / 环境安装 / 进入 xrk）

cd "$HOME" || exit

XRK_ROOT="${XRK_ROOT:-/xrk}"

_xm_init() {
    root="${XRK_ROOT:-/xrk}"
    if [ -f "$root/shell_modules/xm_head.sh" ]; then
        # shellcheck source=/dev/null
        source "$root/shell_modules/xm_head.sh"
    else
        [ -f "$HOME/.xrk_repo" ] && source "$HOME/.xrk_repo"
        # shellcheck source=/dev/null
        source <(curl -sL "${SCRIPT_RAW_BASE:-https://gitee.com/xrkseek/xrk-projects-scripts/raw/master}/shell_modules/bootstrap.sh")
        xrk_ensure_bootstrap
        xrk_load_xm
    fi
}
_xm_init

require_xrk() {
    type xrk_is_script_repo &>/dev/null && xrk_is_script_repo || {
        menu_msg_err "请先 xm→2 安装本仓库（${XRK_ROOT:-/xrk} 不是 xrk-projects-scripts）"
        return 1
    }
}

update_xm() {
    local xm_path
    xm_path=$(type -p xm 2>/dev/null || command -v xm)
    [ -z "$xm_path" ] && xm_path="/usr/local/bin/xm"
    xrk_ensure_bootstrap
    echo "[xm] 正在更新…"
    if xrk_download "${SCRIPT_RAW_BASE}/body/xm" "$xm_path" 3 && chmod +x "$xm_path"; then
        echo "[xm] 已更新: $xm_path"
    else
        echo "[xm] 更新失败，请检查网络或 SCRIPT_RAW_BASE"
        return 1
    fi
    if type xrk_is_script_repo &>/dev/null && xrk_is_script_repo; then
        (cd "$XRK_ROOT" && git pull --no-rebase) && echo "[xm] 脚本仓库 $XRK_ROOT 已更新" || echo "[xm] $XRK_ROOT 更新失败或非 git 目录"
    fi
    echo "[xm] 更新完成"
}

show_menu() {
    local opts=("换源(apt 镜像)" "安装脚本仓库" "环境与工具安装")
    type xrk_is_script_repo &>/dev/null && xrk_is_script_repo && opts+=("进入主菜单(xrk)")
    opts+=("退出")
    echo ""
    menu_show "xm 主菜单" "  " "${opts[@]}" "输入 0/q 或最后一档退出，r 更新 xm"
    echo ""
}

while true; do
    show_menu
    choice=$(menu_read_choice "请选择 [0-${MENU_OPT_COUNT}]，r 更新 xm: ") || { echo "再见"; exit 0; }
    [ -z "$choice" ] && continue
    [ "$choice" = "r" ] && { update_xm; continue; }
    menu_should_exit "$choice" back && { echo "再见"; exit 0; }
    case "$choice" in
        1) change_source_linux ;;
        2)
            xrk_ensure_bootstrap
            [ -z "${SCRIPT_CLONE_URL:-}" ] && { menu_msg_err "无法获取克隆地址"; continue; }
            if [ -d "$XRK_ROOT" ]; then
                menu_confirm "$XRK_ROOT 已存在，是否删除并重新克隆? (y/N)" || { menu_msg_warn "已取消"; continue; }
                rm -rf "$XRK_ROOT"
            fi
            if git clone --depth=1 "$SCRIPT_CLONE_URL" "$XRK_ROOT"; then
                printf 'SCRIPT_RAW_BASE="%s"\nSCRIPT_CLONE_URL="%s"\n' "$SCRIPT_RAW_BASE" "$SCRIPT_CLONE_URL" > "$XRK_ROOT/.repo_source"
                menu_msg_ok "脚本仓库已安装到 $XRK_ROOT"
            else
                menu_msg_err "克隆失败，请检查网络"
            fi
            ;;
        3)
            if type xrk_exec_script &>/dev/null; then
                xrk_exec_script "shell_modules/env_menu.sh"
            else
                bash <(curl -sL "${SCRIPT_RAW_BASE:-https://gitee.com/xrkseek/xrk-projects-scripts/raw/master}/shell_modules/env_menu.sh")
            fi
            ;;
        4)
            require_xrk || continue
            exec bash "$XRK_ROOT/body/xrk"
            ;;
        *) menu_msg_err ;;
    esac
done
