#!/bin/bash
# Node.js 安装：使用最新 LTS，支持 x64/arm64/armv7l/ppc64le/s390x

set -e
XRK_ROOT="${XRK_ROOT:-/xrk}"
SCRIPT_RAW_BASE="${SCRIPT_RAW_BASE:-https://gitee.com/xrkseek/xrk-projects-scripts/raw/master}"
if [ -f "${XRK_ROOT}/shell_modules/software_head.sh" ]; then
    # shellcheck source=/dev/null
    source "${XRK_ROOT}/shell_modules/software_head.sh"
else
    # shellcheck source=/dev/null
    source <(curl -sL "$SCRIPT_RAW_BASE/shell_modules/software_head.sh")
fi

# Node 官方支持：x64 arm64 armv7l ppc64le s390x
arch=$(detect_arch)
case "$arch" in
    x64|arm64|armv7l|ppc64le|s390x) ;;
    *) echo -e "${RED}不支持的架构: $(uname -m)${NC}"; exit 1 ;;
esac

LATEST_VERSION="$NODE_LTS_VERSION"
MIN_MAJOR_VERSION=$(echo "$LATEST_VERSION" | sed 's/^v//' | cut -d'.' -f1)

check_permission() {
    if [ ! -w "/usr/local/bin" ] && [ "$EUID" -ne 0 ]; then
        echo -e "${RED}错误: 需要管理员权限，请使用 sudo${NC}"
        exit 1
    fi
}

check_nodejs_version() {
    if command -v node &>/dev/null; then
        local current_major=$(node -v | sed 's/^v//' | cut -d'.' -f1)
        echo -e "${BLUE}检测到已安装 Node.js $(node -v)${NC}"
        if [ "$current_major" -ge "$MIN_MAJOR_VERSION" ]; then
            echo -e "${GREEN}✅ 当前版本已满足 LTS 要求，跳过安装${NC}"
            return 1
        fi
        echo -e "${YELLOW}⚠️ 当前版本过低，开始升级到 LTS...${NC}"
    else
        echo -e "${BLUE}未检测到 Node.js，开始全新安装...${NC}"
    fi
    return 0
}

install_nodejs() {
    local url="https://nodejs.org/dist/$LATEST_VERSION/node-$LATEST_VERSION-linux-$arch.tar.xz"
    local temp_dir
    temp_dir=$(mktemp -d)
    echo -e "${BLUE}开始安装 Node.js $LATEST_VERSION (LTS) [$arch]${NC}"
    (cd "$temp_dir" && xrk_download_quiet "$url" "node-$LATEST_VERSION-linux-$arch.tar.xz" 3) &
    show_progress "下载 Node.js $LATEST_VERSION"
    (cd "$temp_dir" && tar -xf "node-$LATEST_VERSION-linux-$arch.tar.xz" && \
        sudo mkdir -p /opt/node && sudo rm -rf /opt/node/* && \
        sudo mv "node-$LATEST_VERSION-linux-$arch"/* /opt/node/ && \
        sudo ln -sf /opt/node/bin/node /usr/local/bin/node && \
        sudo ln -sf /opt/node/bin/npm /usr/local/bin/npm && \
        sudo ln -sf /opt/node/bin/npx /usr/local/bin/npx) &
    show_progress "安装 Node.js"
    rm -rf "$temp_dir"
    echo "$PATH" | grep -q "/opt/node/bin" || { echo 'export PATH=$PATH:/opt/node/bin' >> "$HOME/.bashrc"; export PATH=$PATH:/opt/node/bin; }
}

setup_and_verify() {
    type xrk_setup_js_mirrors &>/dev/null && { xrk_setup_js_mirrors & }; 
    show_progress "配置 JS 镜像源"
    command -v node &>/dev/null && command -v npm &>/dev/null && \
        echo -e "${GREEN}✅ Node.js: $(node -v)  npm: $(npm -v)${NC}" || { echo -e "${RED}❌ 安装失败${NC}"; exit 1; }
}

check_permission
if check_nodejs_version; then
    install_nodejs
    setup_and_verify
    echo -e "${GREEN}🎉 Node.js LTS 安装完成${NC}"
else
    type xrk_setup_js_mirrors &>/dev/null && xrk_setup_js_mirrors
    echo -e "${GREEN}🎉 Node.js 环境已就绪${NC}"
fi
